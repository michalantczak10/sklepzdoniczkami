{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BackupOps",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::YOUR_BACKUP_BUCKET",
        "arn:aws:s3:::YOUR_BACKUP_BUCKET/*"
      ]
    },
    {
      "Sid": "AllowKmsIfNeeded",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:kms:REGION:ACCOUNT_ID:key/YOUR_KMS_KEY_ID"
      ]
    }
  ]
}
