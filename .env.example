# Local development example env
APP_ENV=development
DATABASE_NAME_DEVELOPMENT=sklepzdoniczkami_dev
POSTGRES_PASSWORD=sklepzdoniczkami_dev_pass
DATABASE_URL_DEVELOPMENT=postgresql://sklepzdoniczkami:sklepzdoniczkami_dev_pass@127.0.0.1:5434/sklepzdoniczkami_dev
DJANGO_SECRET_KEY_DEVELOPMENT=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SITE_NAME=Sklepzdoniczkami

# If changing POSTGRES_PASSWORD, update the password in DATABASE_URL_DEVELOPMENT too.
# Keep this local-only password out of shared and production environments.
# STRIPE_SECRET_KEY_DEVELOPMENT=
# STRIPE_PUBLIC_KEY_DEVELOPMENT=
# STRIPE_WEBHOOK_SECRET_DEVELOPMENT=
