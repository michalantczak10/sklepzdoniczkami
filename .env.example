# Local development example env
APP_ENV=development
DATABASE_NAME_DEVELOPMENT=sklepzdoniczkami_dev
DJANGO_SECRET_KEY_DEVELOPMENT=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
SITE_NAME=Sklepzdoniczkami

