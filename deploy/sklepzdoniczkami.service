[Unit]
Description=Sklepzdoniczkami Django application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/sklepzdoniczkami/app.env
Environment=DJANGO_ENV_FILE=/etc/sklepzdoniczkami/app.env
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=@APP_DIR@/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=sklepzdoniczkami
StateDirectoryMode=0750
ReadWritePaths=/var/lib/sklepzdoniczkami

[Install]
WantedBy=multi-user.target
