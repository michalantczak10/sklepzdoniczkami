[Unit]
Description=Sklepzdoniczkami preproduction Django application
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=sklepzdoniczkami-preprod
Group=sklepzdoniczkami-preprod
WorkingDirectory=/opt/sklepzdoniczkami-preprod
EnvironmentFile=/etc/sklepzdoniczkami/preprod.env
Environment=DJANGO_ENV_FILE=/etc/sklepzdoniczkami/preprod.env
Environment=DJANGO_SETTINGS_MODULE=config.settings
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/tmp
ExecStart=/opt/sklepzdoniczkami-preprod/.venv/bin/gunicorn --no-control-socket --workers 3 --bind 127.0.0.1:8002 --certfile /etc/sklepzdoniczkami/tls/localhost.crt --keyfile /etc/sklepzdoniczkami/tls/preprod.key config.wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=sklepzdoniczkami-preprod
StateDirectoryMode=0750
ReadWritePaths=/var/lib/sklepzdoniczkami-preprod

[Install]
WantedBy=multi-user.target
