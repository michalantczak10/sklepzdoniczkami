[Unit]
Description=Sklepzdoniczkami local @PROFILE@ profile
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=@APP_USER@
Group=@APP_GROUP@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/sklepzdoniczkami/@PROFILE@.env
Environment=DJANGO_ENV_FILE=/etc/sklepzdoniczkami/@PROFILE@.env
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=@APP_DIR@/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:@PORT@ --certfile /etc/sklepzdoniczkami/tls/localhost.crt --keyfile /etc/sklepzdoniczkami/tls/localhost.key config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sklepzdoniczkami/@PROFILE@

[Install]
WantedBy=multi-user.target
